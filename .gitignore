# Only public source, generic tests and release artwork belong in Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Package/
!/Tests/
!/dist/
!/docs/

/docs/*
!/docs/SECURITY_ARCHITECTURE_CURRENT.md
!/docs/POLYMORPHIC_CODEC_DESIGN.md
!/docs/ROADMAP_STATUS.md
!/docs/GPU_CAPTURE_THREAT_MODEL.md

/Package/*
!/Package/Assets/
/Package/Assets/*
!/Package/Assets/LinuxAvatarGuard/
!/Package/Assets/LinuxAvatarGuard.meta

/Tests/*
!/Tests/test_osc.py
!/Tests/LAGValidation.cs
!/Tests/LAGBackendValidation.cs
!/Tests/LinuxAvatarGuard.Validation.asmdef
!/Tests/build_release.py
!/Tests/LAGSecurityBaseline.cs
!/Tests/LAGCodecValidation.cs
!/Tests/LAGImplementationValidation.cs
!/Tests/legacy-decoder-v1.txt
!/Tests/LAGGpuCapture.cs
!/Tests/LAGPreparationValidation.cs
!/Tests/analyze_gpu_capture.py

/dist/*
!/dist/booth/
/dist/booth/*
!/dist/booth/Cover.svg
!/dist/booth/Cover.png
!/dist/booth/Workflow.svg
!/dist/booth/Workflow.png
!/dist/booth/BOOTH-LISTING.md
!/dist/booth/RELEASE-VALIDATION.md

**/__pycache__/
**/*.pyc
**/*.log
**/LinuxAvatarGuardGenerated/
**/Library/
**/Temp/
**/UserSettings/
**/private/
**/key.json
**/status.json
**/keys/
**/secrets/
**/*.lagprivate
**/private-manifest*
**/*.vrca
