# Only public source, generic tests and release artwork belong in Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Package/
!/Tests/
!/dist/

/Package/*
!/Package/Assets/
/Package/Assets/*
!/Package/Assets/LinuxAvatarGuard/
!/Package/Assets/LinuxAvatarGuard.meta

/Tests/*
!/Tests/test_osc.py
!/Tests/LAGValidation.cs
!/Tests/LAGBackendValidation.cs
!/Tests/LinuxAvatarGuard.Validation.asmdef
!/Tests/build_release.py

/dist/*
!/dist/booth/
/dist/booth/*
!/dist/booth/Cover.svg
!/dist/booth/Cover.png
!/dist/booth/Workflow.svg
!/dist/booth/Workflow.png
!/dist/booth/BOOTH-LISTING.md
!/dist/booth/RELEASE-VALIDATION.md

**/__pycache__/
**/*.pyc
**/*.log
**/LinuxAvatarGuardGenerated/
**/Library/
**/Temp/
**/UserSettings/
**/private/
**/key.json
**/status.json
**/*.vrca
